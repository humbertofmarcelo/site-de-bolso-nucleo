---
import Base from "../layouts/Base.astro";
import site from "../config/site.json";
import { obterComponenteSecao } from "../components/registry";

interface SecaoConfig {
  id: string;
  tipo: string;
  variante?: string;
  [key: string]: any;
}

const secoes = (site.secoes as SecaoConfig[])
  .map((item) => ({
    id: item.id,
    tipo: item.tipo,
    Componente: obterComponenteSecao(site.colecao, item.tipo, item.variante),
    config: item,
  }))
  .filter((item) => item.Componente !== null);
---

<Base>
  <main>
    {secoes.map(({ id, Componente, config }) => (
      <Componente id={id} {...config} />
    ))}
  </main>
</Base>