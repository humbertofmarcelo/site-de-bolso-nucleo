---
// Tokens: text-ink, text-ink-soft, border-line, rounded-card, bg-white, p-6, space-y-4, mt-8, text-balance, text-lg, text-sm
// cliente.json: formacao (titulo, instituicao)
import Section from "../ui/Section.astro";
import cliente from "../../content/cliente.json";

const formacoes = cliente.formacao || [];
---
<Section id="formacao">
  <h2 class="texto-subtitulo text-balance">Formação e Qualificações</h2>

  <div class="mt-8 space-y-4">
    {formacoes.map((item) => (
      <div class="bg-white border border-line rounded-card p-6">
        <h3 class="text-lg text-ink font-medium text-balance">
          {item.titulo}
        </h3>
        <p class="text-sm text-ink-soft mt-1">
          {item.instituicao}
        </p>
      </div>
    ))}
  </div>
</Section>
