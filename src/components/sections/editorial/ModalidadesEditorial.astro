---
// Tokens: border, border-line-dark, rounded-card, p-6, p-8, text-ink-light, text-ink-light-soft, text-xl, text-base, text-balance, mt-4, mt-8, space-y-6, flex, justify-center
// cliente.json: modalidades_info
import Section from "../../ui/Section.astro";
import BotaoWhatsapp from "../../common/BotaoWhatsapp.astro";
import cliente from "../../../content/cliente.json";

const modalidades = cliente.modalidades_info || [];
---
<Section id="modalidades" tom="base" largura="padrao">
  <div class="text-center">
    <h2 class="texto-subtitulo text-ink-light text-balance">
      Formas de atendimento
    </h2>
  </div>

  <div class="mt-8 space-y-6">
    {modalidades.map((item) => (
      <div class="border border-line-dark rounded-card p-6 md:p-8">
        <h3 class="text-xl text-ink-light font-medium text-balance">
          {item.titulo}
        </h3>
        <p class="text-base text-ink-light-soft mt-4 leading-relaxed">
          {item.descricao}
        </p>
      </div>
    ))}
  </div>

  <div class="mt-8 flex justify-center">
    <BotaoWhatsapp rotulo="AGENDE UM ATENDIMENTO" />
  </div>
</Section>
