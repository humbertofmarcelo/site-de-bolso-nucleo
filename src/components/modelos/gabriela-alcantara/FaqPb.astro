---
// Tokens: text-2xl, text-lg, text-base, text-ink, text-ink-soft, text-balance, bg-surface-card, border, border-t, border-line, rounded-card, p-6, pt-4, mt-4, mt-8, space-y-4, flex, gap-4, justify-between, items-center, font-medium, cursor-pointer, list-none, shrink-0, transition-transform, group-open:rotate-180, leading-relaxed, text-center
// cliente.json: faq (pergunta, resposta)
import Section from "../../ui/Section.astro";
import cliente from "../../../content/cliente.json";

const faq = cliente.faq || [];
---

<Section id="faq" tom="soft" largura="padrao">
  <div class="text-center">
    <h2 class="text-2xl text-ink text-balance font-medium">
      Dúvidas frequentes
    </h2>
  </div>

  <div class="mt-8 space-y-4">
    {faq.map((item: any) => (
      <details class="bg-surface-card border border-line rounded-card p-6 group">
        <summary class="text-lg text-ink font-medium cursor-pointer list-none flex gap-4 justify-between items-center">
          <span>{item.pergunta}</span>
          <span aria-hidden="true" class="shrink-0 text-ink-soft transition-transform group-open:rotate-180">
            ↓
          </span>
        </summary>
        <p class="text-base text-ink-soft mt-4 leading-relaxed pt-4 border-t border-line">
          {item.resposta}
        </p>
      </details>
    ))}
  </div>
</Section>
