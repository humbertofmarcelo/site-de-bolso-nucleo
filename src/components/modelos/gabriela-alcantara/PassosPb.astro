---
// Tokens: text-2xl, text-3xl, text-xl, text-base, text-ink, text-ink-soft, text-balance, border-t, border-b, border-line, py-6, mt-4, mt-8, space-y-6, flex, justify-center, md:grid, md:grid-cols-3, md:gap-8, md:space-y-0
// cliente.json: passos_processo (numero, titulo, descricao)
import Section from "../../ui/Section.astro";
import BotaoAgendamento from "../../common/BotaoAgendamento.astro";
import cliente from "../../../content/cliente.json";

const passos = (cliente as any).passos_processo || [
  {
    numero: "01",
    titulo: "Primeiro contato",
    descricao: "Conversamos brevemente pelo WhatsApp para entender suas necessidades e agendarmos a primeira sessão.",
  },
  {
    numero: "02",
    titulo: "Sessões regulares",
    descricao: "Encontros semanais online de 50 minutos, em ambiente seguro, sigiloso e acolhedor.",
  },
  {
    numero: "03",
    titulo: "Acompanhamento contínuo",
    descricao: "Trabalhamos juntos no seu ritmo, construindo ferramentas para o seu bem-estar emocional.",
  },
];
---

<Section id="passos" tom="alt" largura="ampla">
  <div class="text-center">
    <h2 class="text-2xl text-ink text-balance font-medium">
      Como funciona o processo terapêutico
    </h2>
  </div>

  <div class="mt-12 md:grid md:grid-cols-3 md:gap-8 md:border-t md:border-line md:pt-8 space-y-6 md:space-y-0">
    {passos.map((passo: any) => (
      <div class="border-b md:border-b-0 border-line pb-6 md:pb-0">
        <span class="text-3xl font-bold text-ink-soft opacity-60">
          {passo.numero}
        </span>
        <h3 class="text-xl text-ink font-medium mt-2 text-balance">
          {passo.titulo}
        </h3>
        <p class="text-base text-ink-soft mt-3 leading-relaxed">
          {passo.descricao}
        </p>
      </div>
    ))}
  </div>

  <div class="mt-12 flex justify-center">
    <BotaoAgendamento rotulo="Agendar consulta" />
  </div>
</Section>
