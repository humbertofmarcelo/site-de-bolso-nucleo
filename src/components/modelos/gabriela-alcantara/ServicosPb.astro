---
// Tokens: text-2xl, text-xl, text-base, text-ink, text-ink-soft, text-balance, bg-surface-card, border, border-line, rounded-card, p-6, md:p-8, mt-3, mt-8, grid, grid-cols-1, gap-6, md:grid-cols-2, md:grid-cols-3, flex, flex-col, justify-between, shadow-sm, font-medium, leading-relaxed, text-center, md:text-left
// cliente.json: servicos (titulo, descricao)
import Section from "../../ui/Section.astro";
import cliente from "../../../content/cliente.json";

const servicos = cliente.servicos || [];
const colsClasse = servicos.length >= 3 ? "md:grid-cols-3" : "md:grid-cols-2";
---

<Section id="servicos" tom="soft" largura="ampla">
  <div class="text-center md:text-left">
    <h2 class="text-2xl text-ink text-balance font-medium">
      Serviços
    </h2>
  </div>

  <div class={`mt-8 grid grid-cols-1 ${colsClasse} gap-6`}>
    {servicos.map((servico: any) => (
      <div class="bg-surface-card border border-line rounded-card p-6 md:p-8 flex flex-col justify-between shadow-sm">
        <div>
          <h3 class="text-xl text-ink font-medium text-balance">
            {servico.titulo}
          </h3>
          <p class="text-base text-ink-soft mt-3 leading-relaxed">
            {servico.descricao}
          </p>
        </div>
      </div>
    ))}
  </div>
</Section>
