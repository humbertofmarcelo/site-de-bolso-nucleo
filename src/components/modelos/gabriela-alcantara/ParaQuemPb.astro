---
// Tokens: text-2xl, text-ink, text-ink-soft, text-base, text-balance, border, border-line, mt-3, mt-6, mt-8, md:mt-0, space-y-4, flex, items-start, justify-center, gap-3, w-full, max-w-sm, h-80, object-cover, grayscale, contrast-125, overflow-hidden, shadow-sm, font-medium, font-bold, md:grid, md:grid-cols-2, md:gap-12, md:items-center
// cliente.json: nome, demandas_titulo, demandas_subtitulo, demandas, imagens.sobre
import Section from "../../ui/Section.astro";
import cliente from "../../../content/cliente.json";

const titulo = (cliente as any).demandas_titulo || "Para quem é a terapia?";
const subtitulo =
  (cliente as any).demandas_subtitulo ||
  "A psicoterapia é indicada se você tem vivenciado:";
const itens = (cliente as any).demandas || [
  "Ansiedade e estresse constante",
  "Dificuldade nos relacionamentos afetivos e familiares",
  "Momentos de transição de vida e carreira",
  "Busca por autoconhecimento e clareza de objetivos",
  "Dificuldade para lidar com emoções difíceis",
];

const imgTextura = cliente.imagens?.sobre?.arquivo || "/images/sobre.webp";
---

<Section id="para-quem" tom="alt" largura="ampla">
  <div class="md:grid md:grid-cols-2 md:gap-12 md:items-center">
    <div>
      <h2 class="text-2xl text-ink text-balance font-medium">
        {titulo}
      </h2>
      <p class="text-base text-ink-soft mt-3">
        {subtitulo}
      </p>

      <div class="mt-6 space-y-4 text-base text-ink">
        {
          itens.map((item: string) => (
            <p class="flex items-start ">
              <span class="text-ink font-bold" aria-hidden="true" />
              <span>{item}</span>
            </p>
          ))
        }
      </div>
    </div>

    <div class="mt-8 md:mt-0 flex justify-center">
      <div class="overflow-hidden border border-line shadow-sm w-full max-w-sm">
        <img
          src={imgTextura}
          alt={`Acolhimento profissional com ${cliente.nome}`}
          class="w-full h-80 object-cover grayscale contrast-125"
          loading="lazy"
        />
      </div>
    </div>
  </div>
</Section>
