---
// Tokens: relative, w-full, h-full, md:min-h-130, lg:min-h-150, object-cover, object-top, md:object-right-top, pointer-events-none, z-10, mx-auto, max-w-4xl, max-w-sm, max-w-xl, lg:max-w-md, md:max-w-none, px-6, py-8, md:py-20, md:pt-12, md:pb-20, pb-6, md:pb-0, md:pb-6, flex, flex-col, justify-between, justify-center, items-center, order-first, md:order-last, block, hidden, md:block, md:hidden, md:flex, md:grid, md:grid-cols-2, md:gap-12, md:items-center, text-sm, font-medium, mt-8, mt-48, md:mt-12, md:mt-20, mt-6, mt-10, mb-8, md:mb-0, texto-titulo, text-balance, texto-corpo, leading-relaxed, bg-surface, bg-surface-alt, absolute, inset-0, overflow-hidden, rounded-card, border, border-b, md:border-b, md:border-b-0, border-line, border-line-dark, shadow-sm, text-ink-soft, text-ink-light-soft, text-ink, text-ink-light, md:text-ink-soft, md:text-ink-light-soft, md:text-ink, md:text-ink-light, md:bg-surface, md:bg-surface-alt
// cliente.json: nome, crp, profissao, cidade, titulo_hero, subtitulo_hero, bio, imagens.hero, hero
// Props: id, variante, mobile (objeto com variante e estilos para mobile), desktop (objeto com variante e estilos para desktop)
import Section from "../../ui/Section.astro";
import BotaoWhatsapp from "../../common/BotaoWhatsapp.astro";
import cliente from "../../../content/cliente.json";

type TipoVarianteHero = "overlay" | "editorial" | "nenhum" | "padrao" | "card" | "split" | "sem-foto" | boolean;

interface Props {
  id?: string;
  variante?: TipoVarianteHero;
  mobile?: {
    variante?: TipoVarianteHero;
    fundo?: "solido" | "dark" | "light";
    gradiente?: "light" | "dark" | "nenhum" | boolean;
    tema_texto?: "light" | "dark";
    tema_texto_topo?: "light" | "dark";
    tema_texto_titulo?: "light" | "dark";
    tema_texto_subtitulo?: "light" | "dark";
    variante_botao?: "normal" | "light" | "dark";
  };
  desktop?: {
    variante?: TipoVarianteHero;
    fundo?: "solido" | "gradiente" | "dark" | "light";
    direcao_gradiente?: "light-para-dark" | "dark-para-light";
    extensao_gradiente?: number | string;
    gradiente?: "light" | "dark" | "nenhum" | boolean;
    tema_texto?: "light" | "dark";
    tema_texto_topo?: "light" | "dark";
    tema_texto_titulo?: "light" | "dark";
    tema_texto_subtitulo?: "light" | "dark";
    variante_botao?: "normal" | "light" | "dark";
  };
  [key: string]: any;
}

function normalizarVariante(v?: TipoVarianteHero): "overlay" | "editorial" | "nenhum" {
  if (v === false || v === "nenhum" || v === "sem-foto") {
    return "nenhum";
  }
  if (v === "editorial" || v === "card" || v === "split" || v === "padrao") {
    return "editorial";
  }
  return "overlay";
}

const props = Astro.props;
const { id = "inicio" } = props;

const heroImg = cliente.imagens?.hero;
const temImagem = Boolean(heroImg?.arquivo || heroImg?.desktop || heroImg?.mobile);
const imgDesktop = heroImg?.desktop || heroImg?.arquivo;
const imgMobile = heroImg?.mobile || heroImg?.arquivo;
const fotoCard = heroImg?.arquivo || heroImg?.mobile || heroImg?.desktop;
const altTexto = heroImg?.alt || `Retrato de ${cliente.nome}`;

const titulo = cliente.titulo_hero || `${cliente.profissao} em ${cliente.cidade}`;
const descricao = cliente.subtitulo_hero || cliente.bio;

const clienteHero = (cliente as any).hero || (cliente as any).hero_config || {};

// ==========================================
// 0. RESOLUÇÃO DE VARIANTE POR DISPOSITIVO
// ==========================================
const confMobile = { ...(props.mobile || {}), ...(clienteHero.mobile || {}) };
const confDesktop = { ...(props.desktop || {}), ...(clienteHero.desktop || {}) };

const varianteGeral = clienteHero.variante ?? props.variante ?? "overlay";
const varianteMobile = normalizarVariante(
  confMobile.variante ?? props.variante_mobile ?? varianteGeral
);
const varianteDesktop = normalizarVariante(
  confDesktop.variante ?? props.variante_desktop ?? varianteGeral
);

const ehOverlayMobile = varianteMobile === "overlay";
const ehOverlayDesktop = varianteDesktop === "overlay";
const ehEditorialMobile = varianteMobile === "editorial";
const ehEditorialDesktop = varianteDesktop === "editorial";

// ==========================================
// 1. RESOLUÇÃO DE CONFIGURAÇÕES PARA MOBILE
// ==========================================
const gradienteMobileRaw =
  confMobile.gradiente ??
  props.gradiente_mobile ??
  props.gradiente ??
  "dark";

const temGradienteMobile =
  ehOverlayMobile &&
  gradienteMobileRaw !== "nenhum" &&
  gradienteMobileRaw !== false &&
  gradienteMobileRaw !== "desativado";
const temaGradienteMobile: "light" | "dark" | null = temGradienteMobile
  ? gradienteMobileRaw === "light"
    ? "light"
    : "dark"
  : null;

const fundoMobileTipo =
  confMobile.fundo ??
  props.fundo_mobile ??
  (temaGradienteMobile === "light" ? "light" : "dark");
const classeFundoMobile = fundoMobileTipo === "light" ? "bg-surface-alt" : "bg-surface";

const temaTextoMobilePadrao = ehOverlayMobile
  ? temaGradienteMobile === "dark"
    ? "light"
    : "dark"
  : fundoMobileTipo === "light"
    ? "dark"
    : "light";

const temaTextoMobileGeral =
  confMobile.tema_texto ??
  props.tema_texto_mobile ??
  props.tema_texto ??
  temaTextoMobilePadrao;

const temaTopoMobile =
  confMobile.tema_texto_topo ??
  props.tema_texto_topo_mobile ??
  props.tema_texto_topo ??
  (ehOverlayMobile ? temaTextoMobileGeral : temaTextoMobilePadrao);
const temaTituloMobile =
  confMobile.tema_texto_titulo ??
  props.tema_texto_titulo_mobile ??
  props.tema_texto_titulo ??
  temaTextoMobileGeral;
const temaSubtituloMobile =
  confMobile.tema_texto_subtitulo ??
  props.tema_texto_subtitulo_mobile ??
  props.tema_texto_subtitulo ??
  temaTextoMobileGeral;

// ==========================================
// 2. RESOLUÇÃO DE CONFIGURAÇÕES PARA DESKTOP
// ==========================================
const fundoDesktopExplicito = clienteHero.desktop?.fundo ?? props.fundo_desktop ?? props.fundo;
const fundoTipoDesktop = ehOverlayDesktop
  ? (confDesktop.fundo ?? props.fundo_desktop ?? props.fundo ?? "gradiente")
  : (fundoDesktopExplicito ?? (confDesktop.tema_texto === "light" ? "dark" : "light"));

const ehFundoGradienteDesktop = fundoTipoDesktop === "gradiente";
const direcaoGradienteDesktop =
  confDesktop.direcao_gradiente ??
  props.direcao_gradiente_desktop ??
  props.direcao_gradiente ??
  "light-para-dark";

const extensaoRaw =
  confDesktop.extensao_gradiente ??
  props.extensao_gradiente_desktop ??
  props.extensao_gradiente ??
  45;
const extensaoNum = typeof extensaoRaw === "string" ? parseInt(extensaoRaw, 10) : extensaoRaw;
const extensaoFinal = isNaN(extensaoNum) ? 45 : Math.max(5, Math.min(95, extensaoNum));

const gradienteDesktopRaw =
  confDesktop.gradiente ??
  props.gradiente_desktop ??
  (ehFundoGradienteDesktop ? "nenhum" : props.gradiente ?? "nenhum");

const temGradienteDesktop =
  ehOverlayDesktop &&
  gradienteDesktopRaw !== "nenhum" &&
  gradienteDesktopRaw !== false &&
  gradienteDesktopRaw !== "desativado";
const temaGradienteDesktop: "light" | "dark" | null = temGradienteDesktop
  ? gradienteDesktopRaw === "dark"
    ? "dark"
    : "light"
  : null;

const ladoEsquerdoDesktopEhClaro = ehFundoGradienteDesktop
  ? direcaoGradienteDesktop === "light-para-dark"
  : fundoTipoDesktop !== "dark" && temaGradienteDesktop !== "dark";

const temaTextoDesktopPadrao = ladoEsquerdoDesktopEhClaro ? "dark" : "light";

const temaTextoDesktopGeral =
  confDesktop.tema_texto ??
  props.tema_texto_desktop ??
  props.tema_texto ??
  temaTextoDesktopPadrao;

const temaTopoDesktop =
  confDesktop.tema_texto_topo ??
  props.tema_texto_topo_desktop ??
  props.tema_texto_topo ??
  temaTextoDesktopGeral;
const temaTituloDesktop =
  confDesktop.tema_texto_titulo ??
  props.tema_texto_titulo_desktop ??
  props.tema_texto_titulo ??
  temaTextoDesktopGeral;
const temaSubtituloDesktop =
  confDesktop.tema_texto_subtitulo ??
  props.tema_texto_subtitulo_desktop ??
  props.tema_texto_subtitulo ??
  temaTextoDesktopGeral;

// Classes de fundo do Desktop
let classeFundoDesktop = "";
if (ehFundoGradienteDesktop) {
  classeFundoDesktop =
    direcaoGradienteDesktop === "dark-para-light"
      ? "hero-fundo-desktop-dark-light"
      : "hero-fundo-desktop-light-dark";
} else {
  classeFundoDesktop =
    fundoTipoDesktop === "dark" || temaGradienteDesktop === "dark"
      ? "md:bg-surface"
      : "md:bg-surface-alt";
}

// ==========================================
// 3. COMBINAÇÃO DE CLASSES RESPONSIVAS
// ==========================================

const tomSection: "base" | "alt" | "transparente" = ehFundoGradienteDesktop
  ? "transparente"
  : fundoMobileTipo === "light"
    ? "alt"
    : "base";

const classeFundoContainer = `${classeFundoMobile} ${classeFundoDesktop}`.trim();
const estiloVariavel = ehFundoGradienteDesktop ? `--hero-gradient-ext: ${extensaoFinal}%;` : undefined;

// Visibilidade da foto de fundo (Overlay) por dispositivo
const mostrarPictureOverlay = temImagem && (ehOverlayMobile || ehOverlayDesktop);
const classeVisibilidadeOverlay =
  ehOverlayMobile && ehOverlayDesktop
    ? "block"
    : ehOverlayMobile
      ? "block md:hidden"
      : "hidden md:block";

// Visibilidade da foto em card separado (Editorial) por dispositivo
const mostrarCardEditorial = temImagem && (ehEditorialMobile || ehEditorialDesktop);
const classeVisibilidadeEditorial =
  ehEditorialMobile && ehEditorialDesktop
    ? "flex"
    : ehEditorialMobile
      ? "flex md:hidden"
      : "hidden md:flex";

// Máscaras sobre a foto de fundo
const temAlgumaMascara = temGradienteMobile || temGradienteDesktop;
const classesMascara = [
  "absolute inset-0 pointer-events-none",
  temGradienteMobile ? (temaGradienteMobile === "dark" ? "hero-mask-mobile-dark" : "hero-mask-mobile-light") : "",
  temGradienteDesktop ? (temaGradienteDesktop === "dark" ? "hero-mask-desktop-dark" : "hero-mask-desktop-light") : "",
]
  .filter(Boolean)
  .join(" ");

// Textos (mobile base + md: desktop)
const classeCorTopo = `${temaTopoMobile === "light" ? "text-ink-light-soft" : "text-ink-soft"} ${temaTopoDesktop === "light" ? "md:text-ink-light-soft" : "md:text-ink-soft"}`;
const classeCorTitulo = `${temaTituloMobile === "light" ? "text-ink-light" : "text-ink"} ${temaTituloDesktop === "light" ? "md:text-ink-light" : "md:text-ink"}`;
const classeCorSubtitulo = `${temaSubtituloMobile === "light" ? "text-ink-light-soft" : "text-ink-soft"} ${temaSubtituloDesktop === "light" ? "md:text-ink-light-soft" : "md:text-ink-soft"}`;

// Linha divisória do topo quando não for overlay
const bordaTopoMobile = !ehOverlayMobile ? "pb-6 border-b border-line" : "";
const bordaTopoDesktop = !ehOverlayDesktop ? "md:pb-6 md:border-b md:border-line" : "md:pb-0 md:border-b-0";

// Espaçamento e altura do container interno conforme variante de cada dispositivo
const paddingContainerDesktop = ehOverlayDesktop
  ? "md:pt-12 md:pb-20 md:min-h-130 lg:min-h-150"
  : "md:py-20";

const margemConteudoMobile = ehOverlayMobile ? "mt-48" : "mt-8";
const margemConteudoDesktop = ehOverlayDesktop ? "md:mt-20" : "md:mt-12";
const layoutConteudoDesktop =
  ehEditorialDesktop && temImagem
    ? "md:grid md:grid-cols-2 md:gap-12 md:items-center"
    : "";

const larguraBlocoTexto = ehOverlayDesktop
  ? "max-w-sm lg:max-w-md"
  : ehEditorialDesktop
    ? "max-w-xl md:max-w-none"
    : "max-w-xl";

// Botão de Agendamento (oposto da área de leitura em cada tela)
let varBotaoMobile: "normal" | "light" | "dark" = "normal";
if (ehOverlayMobile && temGradienteMobile) {
  varBotaoMobile = temaGradienteMobile === "dark" ? "light" : "dark";
} else {
  varBotaoMobile = temaTituloMobile === "light" ? "light" : "dark";
}
if (confMobile.variante_botao) varBotaoMobile = confMobile.variante_botao;

let varBotaoDesktop: "normal" | "light" | "dark" = "normal";
if (ehFundoGradienteDesktop) {
  varBotaoDesktop = ladoEsquerdoDesktopEhClaro ? "dark" : "light";
} else if (ehOverlayDesktop && temGradienteDesktop) {
  varBotaoDesktop = temaGradienteDesktop === "dark" ? "light" : "dark";
} else {
  varBotaoDesktop = temaTituloDesktop === "light" ? "light" : "dark";
}
if (confDesktop.variante_botao) varBotaoDesktop = confDesktop.variante_botao;
---
<Section id={id} tom={tomSection} largura="total" semPadding={true}>
  <div class={`relative w-full overflow-hidden ${classeFundoContainer}`} style={estiloVariavel}>
    {mostrarPictureOverlay && (
      <picture class={`absolute inset-0 w-full h-full pointer-events-none ${classeVisibilidadeOverlay}`}>
        {imgDesktop && (
          <source media="(min-width: 768px)" srcset={imgDesktop} />
        )}
        <img
          src={imgMobile || imgDesktop}
          alt={altTexto}
          class="w-full h-full object-cover object-top md:object-right-top"
          loading="eager"
        />
      </picture>
    )}

    {temAlgumaMascara && (
      <div class={classesMascara} />
    )}

    <div class={`relative z-10 mx-auto max-w-4xl px-6 py-8 ${paddingContainerDesktop} flex flex-col`}>
      <!-- Identificação profissional -->
      <div class={`flex justify-between items-center text-sm ${bordaTopoMobile} ${bordaTopoDesktop} ${classeCorTopo}`.trim()}>
        <span class="font-medium">{cliente.nome}</span>
        <span>CRP {cliente.crp}</span>
      </div>

      <!-- Conteúdo principal (adapta entre overlay, editorial split e sem foto por dispositivo) -->
      <div class={`${margemConteudoMobile} ${margemConteudoDesktop} ${layoutConteudoDesktop}`.trim()}>
        {mostrarCardEditorial && (
          <div class={`mb-8 md:mb-0 ${classeVisibilidadeEditorial} justify-center order-first md:order-last`}>
            <img
              src={fotoCard}
              alt={altTexto}
              class="rounded-card border border-line object-cover w-full max-w-sm shadow-sm"
              loading="eager"
            />
          </div>
        )}

        <div class={larguraBlocoTexto}>
          <h1 class={`texto-titulo ${classeCorTitulo} text-balance`}>
            {titulo}
          </h1>

          <p class={`texto-corpo ${classeCorSubtitulo} mt-6 leading-relaxed`}>
            {descricao}
          </p>

          <div class="mt-10">
            <BotaoWhatsapp
              rotulo="AGENDE UM ATENDIMENTO"
              varianteMobile={varBotaoMobile}
              varianteDesktop={varBotaoDesktop}
            />
          </div>
        </div>
      </div>
    </div>
  </div>
</Section>
