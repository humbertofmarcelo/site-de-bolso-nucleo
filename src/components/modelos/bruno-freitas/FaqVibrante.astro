---
// Tokens: text-2xl, text-3xl, text-lg, text-base, text-ink-light, text-ink-light-soft, bg-surface-card, border, border-line-dark, rounded-card, p-6, mt-4, mt-8, space-y-4, md:space-y-0, md:grid, md:grid-cols-2, md:gap-6, md:items-start, flex, justify-between, items-center
// cliente.json: faq (pergunta, resposta)
import Section from "../../ui/Section.astro";
import cliente from "../../../content/cliente.json";

const faq = cliente.faq || [];
---

<Section id="faq" tom="base" largura="ampla">
  <div class="text-center md:text-left">
    <h2 class="text-2xl md:text-3xl text-ink-light font-bold text-balance">
      Perguntas Frequentes
    </h2>
  </div>

  <div class="mt-8 md:grid md:grid-cols-2 md:gap-6 md:items-start space-y-4 md:space-y-0">
    {faq.map((item: any) => (
      <details class="bg-surface-card border border-line-dark rounded-card p-6 group shadow-sm">
        <summary class="text-lg text-ink-light font-bold cursor-pointer list-none flex gap-4 justify-between items-center">
          <span>{item.pergunta}</span>
          <span aria-hidden="true" class="shrink-0 text-ink-light-soft transition-transform group-open:rotate-180">
            ↓
          </span>
        </summary>
        <p class="text-base text-ink-light-soft mt-4 leading-relaxed pt-4 border-t border-line-dark">
          {item.resposta}
        </p>
      </details>
    ))}
  </div>
</Section>
