---
// Tokens: text-2xl, text-xl, text-base, text-ink-light, text-ink-light-soft, mt-4, mt-8, space-y-6, md:space-y-0, md:grid, md:grid-cols-3, md:gap-8, flex, items-start, gap-4
// cliente.json: itens_ajuda, servicos
import Section from "../../ui/Section.astro";
import Icone from "../../common/Icone.astro";
import cliente from "../../../content/cliente.json";

const itens = (cliente as any).itens_ajuda || [
  {
    icone: "ansiedade",
    titulo: "Ansiedade, depressão e estresse",
    descricao: "Compreensão das causas, acolhimento do sofrimento e desenvolvimento de estratégias para recuperar o equilíbrio.",
  },
  {
    icone: "relacionamentos",
    titulo: "Dificuldade nos relacionamentos",
    descricao: "Desenvolvimento de comunicação não-violenta, inteligência emocional e resolução de conflitos afetivos.",
  },
  {
    icone: "luto",
    titulo: "Luto, perdas e transições",
    descricao: "Espaço seguro para processar mudanças profundas de carreira, cidade, perdas e novos ciclos de vida.",
  },
];
---

<Section id="como-ajudar" tom="base" largura="ampla">
  <div class="text-center md:text-left">
    <h2 class="text-2xl md:text-3xl text-ink-light font-bold text-balance">
      Como posso ajudar?
    </h2>
  </div>

  <div class="mt-10 md:grid md:grid-cols-3 md:gap-8 space-y-6 md:space-y-0">
    {itens.map((item: any) => (
      <div class="flex items-start gap-4">
        <span class="text-primary mt-1 shrink-0" aria-hidden="true">
          <Icone nome={item.icone || "ansiedade"} tamanho="lg" />
        </span>
        <div>
          <h3 class="text-xl text-ink-light font-bold text-balance">
            {item.titulo}
          </h3>
          <p class="text-base text-ink-light-soft mt-3 leading-relaxed">
            {item.descricao}
          </p>
        </div>
      </div>
    ))}
  </div>
</Section>
