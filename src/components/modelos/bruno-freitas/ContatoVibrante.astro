---
// Tokens: text-xl, text-2xl, text-sm, text-xs, text-ink-light, text-ink-light-soft, border-t, border-b, border-line-dark, pt-6, pb-8, mt-2, mt-6, space-y-4, text-center, md:text-left, flex, justify-center, md:justify-end, gap-4, md:flex, md:justify-between, md:items-center
// cliente.json: nome, crp, instagram, whatsapp
import Section from "../../ui/Section.astro";
import Icone from "../../common/Icone.astro";
import cliente from "../../../content/cliente.json";
---

<Section id="contato" tom="base" largura="ampla">
  <div class="md:flex md:justify-between md:items-center pb-8 border-b border-line-dark text-center md:text-left">
    <div>
      <h2 class="text-xl md:text-2xl text-ink-light font-bold">
        {cliente.nome}
      </h2>
      <p class="text-sm text-ink-light-soft mt-1">
        {cliente.profissao} · CRP {cliente.crp}
      </p>
    </div>

    <div class="flex justify-center md:justify-end gap-4 mt-6 md:mt-0">
      {cliente.whatsapp && (
        <a
          href={`https://wa.me/${cliente.whatsapp}`}
          class="border border-line-dark rounded-button p-4 text-ink-light hover:bg-primary transition-colors"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="WhatsApp"
        >
          <Icone nome="whatsapp" tamanho="lg" />
        </a>
      )}
      {cliente.instagram && (
        <a
          href={`https://www.instagram.com/${cliente.instagram}`}
          class="border border-line-dark rounded-button p-4 text-ink-light hover:bg-primary transition-colors"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Instagram"
        >
          <Icone nome="instagram" tamanho="lg" />
        </a>
      )}
    </div>
  </div>

  <div class="pt-6 text-center md:text-left text-xs text-ink-light-soft">
    <p>
      Atendimento psicológico estritamente confidencial em conformidade com o Código de Ética Profissional do Psicólogo (CFP).
    </p>
    <p class="mt-2 opacity-75">
      Copyright © 2026 · {cliente.nome}. Todos os direitos reservados.
    </p>
  </div>
</Section>
