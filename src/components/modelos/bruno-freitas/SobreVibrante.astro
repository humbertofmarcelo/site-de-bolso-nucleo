---
// Tokens: text-2xl, text-3xl, text-lg, text-base, text-sm, text-ink, text-ink-soft, rounded-card, border, border-line, mt-4, mt-6, space-y-4, md:grid, md:grid-cols-2, md:gap-12, md:items-center
// cliente.json: nome, profissao, crp, bio, bio_complementar, imagens.sobre
import Section from "../../ui/Section.astro";
import cliente from "../../../content/cliente.json";

const foto = cliente.imagens?.sobre?.arquivo || "/images/sobre.webp";
---

<Section id="sobre" tom="alt" largura="ampla">
  <div class="md:grid md:grid-cols-2 md:gap-12 md:items-center">
    <!-- Coluna Retrato Profissional -->
    <div class="flex justify-center mb-8 md:mb-0">
      <div class="overflow-hidden rounded-card border border-line shadow-sm w-full max-w-sm">
        <img
          src={foto}
          alt={`Sobre ${cliente.nome}`}
          class="w-full h-80 md:h-96 object-cover"
          loading="lazy"
        />
      </div>
    </div>

    <!-- Coluna de Apresentação e Bio -->
    <div class="text-center md:text-left">
      <span class="text-sm text-ink-soft uppercase tracking-wider font-semibold">
        Sobre mim
      </span>
      <h2 class="text-2xl md:text-3xl text-ink font-bold mt-1">
        Prazer, sou {cliente.nome}
      </h2>
      <p class="text-sm text-ink-soft mt-1">
        {cliente.profissao} · CRP {cliente.crp}
      </p>

      <div class="mt-6 text-base text-ink-soft leading-relaxed space-y-4">
        <p>{cliente.bio}</p>
        {cliente.bio_complementar && <p>{cliente.bio_complementar}</p>}
      </div>
    </div>
  </div>
</Section>
