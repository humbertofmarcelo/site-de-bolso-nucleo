---
// Tokens: text-2xl, text-3xl, text-xl, text-lg, text-base, text-sm, text-ink-light, text-ink-light-soft, bg-surface-card, border, border-line-dark, rounded-card, p-5, md:p-6, mt-4, mt-8, space-y-4, md:space-y-0, md:grid, md:grid-cols-2, md:gap-6, flex, items-start, gap-4, justify-center
// cliente.json: passos_sessao
import Section from "../../ui/Section.astro";
import Icone from "../../common/Icone.astro";
import BotaoAgendamento from "../../common/BotaoAgendamento.astro";
import cliente from "../../../content/cliente.json";

const passos = (cliente as any).passos_sessao || [
  {
    icone: "whatsapp",
    titulo: "1. Primeiro contato via WhatsApp",
    descricao: "Tiramos dúvidas iniciais e definimos o melhor horário para você.",
  },
  {
    icone: "calendario",
    titulo: "2. Alinhamento de horários e valores",
    descricao: "Combinamos a frequência das sessões e a forma de pagamento que preferir.",
  },
  {
    icone: "video",
    titulo: "3. Sessões semanais online (50 min)",
    descricao: "Atendimentos individuais por videoconferência em plataforma sigilosa.",
  },
  {
    icone: "estrela",
    titulo: "4. Evolução constante e acolhimento",
    descricao: "Acompanhamento focado nos seus objetivos com empatia e escuta ativa.",
  },
];
---

<Section id="processo" tom="base" largura="ampla">
  <div class="text-center md:text-left">
    <h2 class="text-2xl md:text-3xl text-ink-light font-bold text-balance">
      Como funciona o processo?
    </h2>
    <p class="text-base text-ink-light-soft mt-2">
      Passos transparentes para iniciar com tranquilidade
    </p>
  </div>

  <div class="mt-8 md:grid md:grid-cols-2 md:gap-6 space-y-4 md:space-y-0">
    {passos.map((item: any) => (
      <div class="bg-surface-card border border-line-dark rounded-card p-6 flex items-start gap-4 shadow-sm">
        <span class="text-primary mt-1 shrink-0" aria-hidden="true">
          <Icone nome={item.icone || "chat"} tamanho="lg" />
        </span>
        <div>
          <h3 class="text-lg text-ink-light font-bold text-balance">
            {item.titulo}
          </h3>
          <p class="text-sm text-ink-light-soft mt-2 leading-relaxed">
            {item.descricao}
          </p>
        </div>
      </div>
    ))}
  </div>

  <div class="mt-12 flex justify-center">
    <BotaoAgendamento rotulo="QUERO AGENDAR UMA SESSÃO" />
  </div>
</Section>
