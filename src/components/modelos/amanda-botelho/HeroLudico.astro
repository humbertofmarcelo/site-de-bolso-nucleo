---
// Tokens: relative, md:absolute, md:top-0, md:left-8, md:-translate-y-1/2, z-10, z-20, md:z-20, text-xs, text-sm, text-base, text-xl, text-3xl, text-ink, text-ink-soft, text-ink-light, text-ink-light-soft, text-primary-dark, bg-surface, bg-surface-alt, bg-surface-card, md:bg-surface, md:bg-surface-alt, rounded-card, rounded-button, border, border-2, border-4, border-dashed, border-primary, border-line, border-line-dark, px-3, px-4, px-5, px-6, md:px-2, md:px-8, py-3, py-5, py-6, py-7, py-10, md:py-16, pt-6, pb-5, md:p-0, md:pl-12, mt-1, mt-3, mt-8, mt-16, md:mt-0, md:mt-6, -mt-10, -mt-11, -mt-14, -mt-20, -mt-24, -mt-32, -mb-12, md:mb-0, mb-3, mx-auto, w-full, w-11/12, md:w-full, max-w-sm, md:max-w-md, md:max-w-none, h-64, h-80, h-96, md:h-80, md:h-96, md:h-full, object-cover, block, hidden, md:block, md:hidden, flex, md:flex, md:flex-col, flex-wrap, justify-center, md:justify-start, items-center, md:items-center, md:items-stretch, md:items-start, gap-2, md:gap-8, text-center, text-left, md:grid, md:grid-cols-2, md:grid-cols-12, md:col-span-5, md:col-span-7, md:col-start-1, md:col-start-8, md:row-start-1, shadow-sm, font-serif, italic, font-semibold, font-bold, leading-none, leading-snug, leading-relaxed, space-y-4
// cliente.json: nome, profissao, crp, abordagem, modalidade, bio, bio_complementar, saudacao_hero, tags_hero, hero_card_offset, hero_card_altura, hero_foto_altura, imagens.hero, hero, blocos_texto
// Props: mobile, desktop (liberdade Item 6)
import Section from "../../ui/Section.astro";
import BotaoAgendamento from "../../common/BotaoAgendamento.astro";
import cliente from "../../../content/cliente.json";

interface EstiloBloco {
  arredondado?: boolean;
  tracejado?: boolean;
}

interface Props {
  mobile?: {
    fundo?: "dark" | "light";
    tema_texto?: "light" | "dark";
    variante_botao?: "normal" | "light" | "dark";
  };
  desktop?: {
    fundo?: "dark" | "light";
    tema_texto?: "light" | "dark";
    variante_botao?: "normal" | "light" | "dark";
  };
  [key: string]: any;
}

const props = Astro.props;
const confMobile = props.mobile ?? {};
const confDesktop = props.desktop ?? {};
const clienteAny = cliente as any;
const heroConf = clienteAny.hero || {};
const blocosTexto = clienteAny.blocos_texto || {};
const padraoGlobal: EstiloBloco = blocosTexto.padrao || {};

function resolverClassesBloco(
  chave: string,
  padraoBloco: { arredondado: boolean; tracejado: boolean },
  corBorda: "border-line" | "border-line-dark" = "border-line",
  chaveFallback?: string
): string {
  const confEspecifica: EstiloBloco =
    blocosTexto[chave] || (chaveFallback ? blocosTexto[chaveFallback] : undefined) || {};
  const arredondado =
    confEspecifica.arredondado ?? padraoGlobal.arredondado ?? padraoBloco.arredondado;
  const tracejado =
    confEspecifica.tracejado ?? padraoGlobal.tracejado ?? padraoBloco.tracejado;

  const classeRaio = arredondado ? "rounded-card" : "";
  const classeBorda = tracejado
    ? `border-2 border-dashed ${corBorda}`
    : `border ${corBorda}`;

  return `${classeRaio} ${classeBorda}`.trim();
}

const classesCardIdentificacao = resolverClassesBloco(
  "hero_identificacao",
  { arredondado: false, tracejado: true },
  "border-line-dark"
);
const classesBio1 = resolverClassesBloco(
  "hero_bio_1",
  { arredondado: true, tracejado: false },
  "border-line",
  "hero_bio"
);
const classesBio2 = resolverClassesBloco(
  "hero_bio_2",
  { arredondado: true, tracejado: false },
  "border-line",
  "hero_bio"
);

const heroImg = cliente.imagens?.hero;
const foto = heroImg?.arquivo || heroImg?.desktop || heroImg?.mobile || "/images/sobre.webp";

// Saudação que fica no topo sobre a linha da moldura
const saudacaoHero = heroConf.saudacao || clienteAny.saudacao_hero || "Olá, sou a";

// Tags exibidas na base do card tracejado
const tagsHero: string[] =
  heroConf.tags ||
  clienteAny.tags_hero ||
  [cliente.abordagem, ...(cliente.modalidade || [])].filter(Boolean);

// Controle de offset vertical no mobile (o quanto o card de identificação sobe sobre a foto)
const offsetConfig = heroConf.card_offset || clienteAny.hero_card_offset || "medio";
const mapaOffset: Record<string, string> = {
  minimo: "-mt-10",
  pequeno: "-mt-14",
  medio: "-mt-20",
  grande: "-mt-24",
  extra: "-mt-32",
};
const classeOffsetCard = mapaOffset[offsetConfig] || "-mt-20";

// Controle da altura/espaçamento interno do card de identificação
const alturaCardConfig = heroConf.card_altura || clienteAny.hero_card_altura || "normal";
const mapaAlturaCard: Record<string, string> = {
  compacto: "py-3 px-4",
  normal: "py-5 px-5",
  amplo: "py-7 px-6",
  extra: "py-10 px-6",
};
const classeAlturaCard = mapaAlturaCard[alturaCardConfig] || "py-5 px-5";

// Controle da altura da foto dentro da moldura
const alturaFotoConfig = heroConf.foto_altura || clienteAny.hero_foto_altura || "normal";
const mapaAlturaFoto: Record<string, string> = {
  compacta: "h-64 md:h-80",
  normal: "h-80 md:h-96",
  alta: "h-96 md:h-full",
};
const classeAlturaFoto = mapaAlturaFoto[alturaFotoConfig] || "h-80 md:h-96";

const fundoEscuro = confMobile.fundo === "dark";
const fundoTom = fundoEscuro ? "base" : "alt";
const bgRecorteSaudacao = fundoEscuro ? "bg-surface" : "bg-surface-alt";
const bgRecorteBotaoDesktop = fundoEscuro ? "md:bg-surface" : "md:bg-surface-alt";
const corSaudacao = fundoEscuro ? "text-ink-light" : "text-primary-dark";

const varBotaoMob = confMobile.variante_botao ?? "normal";
const varBotaoDesk = confDesktop.variante_botao ?? "normal";
const temBioComplementar = Boolean(cliente.bio_complementar && cliente.bio_complementar.trim());
---

<Section id="inicio" tom={fundoTom} largura="ampla">
  <!-- Bloco Superior: Moldura (Vertical em Camadas no Mobile / Horizontal Split no Desktop) -->
  <div class="relative w-full max-w-sm md:max-w-none mx-auto pt-6">
    <!-- Moldura Colorida -->
    <div class="border-4 border-primary px-5 pt-6 pb-5 md:p-0 relative md:grid md:grid-cols-12 md:items-stretch">
      <!-- Saudação interrompendo a linha superior da moldura (centralizada no mobile, à esquerda no desktop) -->
      <div class="-mt-11 mb-3 flex justify-center md:absolute md:top-0 md:left-8 md:m-0 md:-translate-y-1/2 md:z-20">
        <span class={`${bgRecorteSaudacao} px-3 text-3xl font-serif italic font-semibold ${corSaudacao} leading-none`}>
          {saudacaoHero}
        </span>
      </div>

      <!-- Foto Principal (No mobile fica no centro da moldura; no desktop ocupa toda a lateral direita da moldura) -->
      <div class="md:col-span-5 md:col-start-8 md:row-start-1">
        <img
          src={foto}
          alt={heroImg?.alt || `Retrato de ${cliente.nome}`}
          class={`w-full ${classeAlturaFoto} md:h-full object-cover block`}
          loading="eager"
        />
      </div>

      <!-- Área do Card de Identificação (No mobile sobrepõe a base da foto e a moldura; no desktop centraliza na coluna esquerda) -->
      <div class="md:col-span-7 md:col-start-1 md:row-start-1 md:flex md:flex-col md:justify-center md:items-center md:px-8 md:py-16">
        <div
          class={`relative z-10 mx-auto w-11/12 md:w-full md:max-w-md ${classeOffsetCard} -mb-12 md:mt-0 md:mb-0 ${classeAlturaCard} bg-surface-alt ${classesCardIdentificacao} text-center shadow-sm`}
        >
          <h1 class="text-xl text-ink font-bold leading-snug">
            {cliente.nome}
          </h1>
          <p class="text-sm text-ink mt-1">
            {cliente.profissao}
          </p>
          <p class="text-sm text-ink mt-1">
            CRP {cliente.crp}
          </p>

          {tagsHero.length > 0 && (
            <div class="mt-3 flex flex-wrap justify-center items-center gap-2 text-xs text-ink">
              {tagsHero.map((tag: string, index: number) => (
                <>
                  {index > 0 && <span class="text-ink-soft" aria-hidden="true">|</span>}
                  <span>{tag}</span>
                </>
              ))}
            </div>
          )}
        </div>
      </div>
    </div>

    <!-- Botão de Agendamento (No mobile fica abaixo do card; no desktop sobe 50% com md:-translate-y-1/2 para a linha passar no meio do botão) -->
    <div class="mt-16 md:mt-0 md:-translate-y-1/2 flex justify-center md:justify-start md:pl-12 relative z-20">
      <div class={`${bgRecorteBotaoDesktop} md:px-2 rounded-button`}>
        <BotaoAgendamento
          rotulo="AGENDE SUA SESSÃO"
          comIcone={true}
          icone="whatsapp"
          varianteMobile={varBotaoMob}
          varianteDesktop={varBotaoDesk}
        />
      </div>
    </div>
  </div>

  <!-- Bloco Inferior: Biografia (1 caixa unificada no Mobile / 2 caixas separadas lado a lado no Desktop) -->
  <div class={`mt-8 md:mt-6 max-w-sm md:max-w-none mx-auto ${temBioComplementar ? "md:grid md:grid-cols-2 md:gap-8 md:items-start" : ""}`}>
    <!-- Caixa 1: No mobile exibe bio + bio_complementar juntos; no desktop exibe apenas bio -->
    <div class={`bg-surface-card ${classesBio1} p-6 text-left text-base text-ink leading-relaxed space-y-4 shadow-sm`}>
      <p>{cliente.bio}</p>
      {temBioComplementar && (
        <p class="md:hidden">{cliente.bio_complementar}</p>
      )}
    </div>

    <!-- Caixa 2 (Exclusiva para Desktop): Exibe bio_complementar em um segundo card ao lado -->
    {temBioComplementar && (
      <div class={`hidden md:block bg-surface-card ${classesBio2} p-6 text-left text-base text-ink leading-relaxed shadow-sm`}>
        <p>{cliente.bio_complementar}</p>
      </div>
    )}
  </div>
</Section>
