---
// Tokens: w-4, w-5, w-6, w-8, h-4, h-5, h-6, h-8, shrink-0, text-primary, text-ink, text-ink-soft, inline-block
// Props: nome (string), tamanho ("sm" | "base" | "lg" | "xl"), class (string opcional)
interface Props {
  nome: string;
  tamanho?: "sm" | "base" | "lg" | "xl";
  class?: string;
}

const { nome, tamanho = "base", class: className = "" } = Astro.props;

const tamanhoClasse =
  tamanho === "sm"
    ? "w-4 h-4"
    : tamanho === "lg"
      ? "w-6 h-6"
      : tamanho === "xl"
        ? "w-8 h-8"
        : "w-5 h-5";
---

{nome === "ansiedade" && (
  <svg class={`${tamanhoClasse} ${className} shrink-0`} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M12 2a8 8 0 0 0-8 8c0 3 2 5.5 4 7v3h8v-3c2-1.5 4-4 4-7a8 8 0 0 0-8-8z" />
    <path d="M10 14h4" />
    <path d="M10 10h4" />
  </svg>
)}

{nome === "depressao" && (
  <svg class={`${tamanhoClasse} ${className} shrink-0`} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z" />
    <path d="M11 13v4" />
    <path d="M15 13v4" />
